# Artefactos de build de Verilator
sim/obj_dir/
sim/*.vcd

# Binarios generados por el toolchain RISC-V (se regeneran con make)
sim/*.elf
sim/*.hex
sim/*.bin

# Excepción: los .hex de firmware que SÍ forman parte del proyecto
# (curados a mano, no artefactos de build de sim/) se mantienen versionados
!sw/tests/*.hex

# Artefactos de Python (modelo de referencia)
__pycache__/
*.pyc

# Binarios compilados de tests nativos (Fase 5) — se regeneran con gcc
sw/tests/native/test_keccak_native
sw/tests/native/*.o

# Artefactos de build de firmware (Fase 5) — se regeneran con el toolchain
sw/tests/build/

# Archivos de sistema
.DS_Store
*.swp
